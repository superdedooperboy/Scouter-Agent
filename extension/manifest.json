{
  "manifest_version": 3,
  "name": "Scouter Web Guard",
  "version": "0.1.0",
  "description": "Warns about ClickFix “paste this command” scams before you get caught — runs entirely in your browser, no account needed.",
  "permissions": ["clipboardWrite", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Scouter Web Guard",
    "default_popup": "popup.html"
  }
}
